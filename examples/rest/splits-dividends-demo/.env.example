# REST API (splits, dividends, aggregates)
MASSIVE_API_KEY=API_KEY_HERE

# Flat Files (S3) – from https://massive.com/dashboard/keys (separate from REST key)
# Used when running with --download-flatfile to pull day-aggregates from Massive.
MASSIVE_FLATFILES_ACCESS_KEY_ID=YOUR_S3_ACCESS_KEY_ID
MASSIVE_FLATFILES_SECRET_ACCESS_KEY=YOUR_S3_SECRET_ACCESS_KEY
# Optional; default is https://files.massive.com
# MASSIVE_FLATFILES_ENDPOINT_URL=https://files.massive.com